# Copy to deploy/vps/.env on the server (chmod 600). Never commit the real file.

# ":80" = plain HTTP on the server IP. Set a domain (e.g. staging.isaleeko.com)
# once its DNS A record points here, and Caddy gets HTTPS automatically.
SITE_ADDRESS=:80

APP_NAME="Ìsàlèè Èkó"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://203.161.46.218
APP_LOCALE=en
LOG_LEVEL=info

DB_DATABASE=isaale_eko
DB_USERNAME=isaale_eko
DB_PASSWORD=

SESSION_DRIVER=database
# true once the site is on HTTPS, otherwise sign-in breaks.
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database

SHOP_CURRENCY=CAD
SHOP_TIMEZONE=America/Moncton

# Test mode: sandbox keys. Switch to production keys only at go-live.
SQUARE_ENV=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_APP_ID=
SQUARE_VERSION=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=
SQUARE_SYNC_ORDERS=true

# Test mode: emails are written to the log (docker compose logs app).
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@isaleeko.com
MAIL_FROM_NAME="Ìsàlèè Èkó"
